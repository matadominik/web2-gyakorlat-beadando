
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Gradebook - E-Crayon</title>

    <link rel="stylesheet" href="/css/bootstrap.css" />
    <link href="https://fonts.googleapis.com/css?family=Open+Sans:400,700|Poppins:400,600,700&display=swap" rel="stylesheet" />
    <link href="/css/style.css" rel="stylesheet" />
    <link href="/css/responsive.css" rel="stylesheet" />
</head>

<body class="sub_page">
    <div class="hero_area">
        <%- include("partials/header") %>
    </div>

    <section class="event_section layout_padding gradebook-page">
        <div class="container">

            <div class="heading_container">
                <h3>Electronic Gradebook</h3>
                <p>Your academic records and grades.</p>
            </div>

            <% if (accountNotLinked) { %>

                <div class="alert alert-warning mt-4">
                    <h5>Student account not linked</h5>
                    <p>
                        Your account has not yet been connected to a student record.
                        Please contact the administrator.
                    </p>
                </div>

            <% } else { %>

                <h4 class="mt-5 mb-3">Students</h4>

                <div class="table-responsive">
                    <table class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>Student ID</th>
                                <th>Name</th>
                                <th>Class</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% if (students && students.length > 0) { %>
                                <% students.forEach(student => { %>
                                    <tr>
                                        <td><%= student.studentId %></td>
                                        <td><%= student.name %></td>
                                        <td><%= student.className %></td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="3">No student data available.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>

                <h4 class="mt-5 mb-3">Subjects</h4>

                <div class="table-responsive">
                    <table class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>Subject</th>
                                <th>Teacher</th>
                                <th>Message</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% if (subjects && subjects.length > 0) { %>
                                <% subjects.forEach(subject => { %>
                                    <tr>
                                        <td><%= subject.name %></td>
                                        <td><%= subject.teacher ? (subject.teacher.displayName || subject.teacherName || subject.teacher.username) : subject.teacherName %></td>
                                        <td>
                                            <% if (subject.teacher && teachers && teachers.some(t => String(t._id) === String(subject.teacher._id))) { %>
                                                <a class="btn btn-sm btn-primary" href="/messages?to=<%= subject.teacher._id %>">Message</a>
                                            <% } else { %><span class="text-muted">-</span><% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="3">No subjects available.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>

                <h4 class="mt-5 mb-3">Grades</h4>

                <div class="table-responsive">
                    <table class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>Student</th>
                                <th>Subject</th>
                                <th>Grade</th>
                                <th>Type</th>
                                <th>Date</th>
                                <th>Given by</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% if (grades && grades.length > 0) { %>
                                <% grades.forEach(grade => { %>
                                    <tr>
                                        <td>
                                            <%= grade.student ? grade.student.name : "Unknown" %>
                                        </td>

                                        <td>
                                            <%= grade.subject ? grade.subject.name : "Unknown" %>
                                        </td>

                                        <td><strong><%= grade.value %></strong></td>
                                        <td><%= grade.type %></td>

                                        <td>
                                            <%= grade.date
                                                ? new Date(grade.date).toLocaleDateString("en-GB")
                                                : "-" %>
                                        </td>

                                        <td><%= grade.teacher ? (grade.teacher.displayName || grade.teacher.username) : "Unknown" %></td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="6">No grades available.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>

            <% } %>
        </div>
    </section>

    <%- include("partials/footer") %>
</body>
</html>
