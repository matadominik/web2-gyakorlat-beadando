<!DOCTYPE html>
<html>

<head>
  <!-- Basic -->
  <meta charset="utf-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <!-- Mobile Metas -->
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
  <!-- Site Metas -->
  <meta name="keywords" content="" />
  <meta name="description" content="" />
  <meta name="author" content="" />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <title>Gradebook</title>

  <!-- bootstrap core css -->
  <link rel="stylesheet" type="text/css" href="css/bootstrap.css" />
  <!-- fonts style -->
  <link href="https://fonts.googleapis.com/css?family=Open+Sans:400,700|Poppins:400,600,700&display=swap" rel="stylesheet" />
  <!-- Custom styles for this template -->
  <link href="css/style.css" rel="stylesheet" />
  <!-- responsive style -->
  <link href="css/responsive.css" rel="stylesheet" />
</head>

<body class="sub_page">
  <div class="hero_area">
        <%- include("partials/header") %>
  </div>

  <!-- event section -->
 <!-- Gradebook section -->
<section class="event_section layout_padding">
    <div class="container">
        <div class="heading_container">
            <h3>Elektronikus napló</h3>
            <p>Tanulók, tantárgyak és érdemjegyek áttekintése.</p>
        </div>

        <!-- Students -->
        <h4 class="mt-5 mb-3">Tanulók</h4>
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Azonosító</th>
                        <th>Név</th>
                        <th>Osztály</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (students && students.length > 0) { %>
                        <% students.forEach(student => { %>
                            <tr>
                                <td><%= student.studentId %></td>
                                <td><%= student.name %></td>
                                <td><%= student.className %></td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="3">Még nincs megjeleníthető tanuló.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <!-- Subjects -->
        <h4 class="mt-5 mb-3">Tantárgyak</h4>
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Tantárgy</th>
                        <th>Tanár neve</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (subjects && subjects.length > 0) { %>
                        <% subjects.forEach(subject => { %>
                            <tr>
                                <td><%= subject.name %></td>
                                <td><%= subject.teacherName %></td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="2">Még nincs megjeleníthető tantárgy.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <!-- Grades -->
        <h4 class="mt-5 mb-3">Érdemjegyek</h4>
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Tanuló</th>
                        <th>Tantárgy</th>
                        <th>Jegy</th>
                        <th>Típus</th>
                        <th>Dátum</th>
                        <th>Megjegyzés</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (grades && grades.length > 0) { %>
                        <% grades.forEach(grade => { %>
                            <tr>
                                <td><%= grade.student ? grade.student.name : "Ismeretlen" %></td>
                                <td><%= grade.subject ? grade.subject.name : "Ismeretlen" %></td>
                                <td><strong><%= grade.value %></strong></td>
                                <td><%= grade.type %></td>
                                <td>
                                    <%= grade.date
                                        ? new Date(grade.date).toLocaleDateString("hu-HU")
                                        : "-" %>
                                </td>
                                <td><%= grade.note || "-" %></td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="6">Még nincs megjeleníthető érdemjegy.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</section>
<!-- End Gradebook section -->

  <!-- end event section -->

  <%- include("partials/footer") %>

</body>

</html>