
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Manage Grades - E-Crayon</title>

    <link rel="stylesheet" href="/css/bootstrap.css" />
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/responsive.css" />
</head>

<body class="sub_page">
    <div class="hero_area">
        <%- include("partials/header") %>
    </div>

    <div class="container py-5">
        <h1 class="mb-4">Manage Grades</h1>

        <% if (typeof message !== "undefined" && message) { %>
            <div class="alert alert-info"><%= message %></div>
        <% } %>

        <% if (canApproveStudents) { %>
        <section class="mb-5">
            <h3 class="mb-3">Pending Student Registrations</h3>
            <p>Review new student accounts and approve or reject each registration.</p>

            <div class="table-responsive">
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>Full Name</th>
                            <th>Class</th>
                            <th>Username</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (!pendingUsers || pendingUsers.length === 0) { %>
                            <tr><td colspan="4">There are no pending registrations.</td></tr>
                        <% } else { %>
                            <% pendingUsers.forEach(pendingUser => { %>
                                <tr>
                                    <td><%= pendingUser.student ? pendingUser.student.name : "Student record missing" %></td>
                                    <td><%= pendingUser.student ? pendingUser.student.className : "-" %></td>
                                    <td><%= pendingUser.username %></td>
                                    <td>
                                        <form action="/manage-grades/approve-user" method="POST" class="d-inline">
                                            <input type="hidden" name="userId" value="<%= pendingUser._id %>">
                                            <button type="submit" class="btn btn-sm btn-success mb-1">Approve</button>
                                        </form>
                                        <form action="/manage-grades/reject-user" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to reject this registration?');">
                                            <input type="hidden" name="userId" value="<%= pendingUser._id %>">
                                            <button type="submit" class="btn btn-sm btn-danger mb-1">Reject</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </section>
        <% } %>

        <hr>

        <h3 class="mb-3">Student Accounts</h3>
        <div class="table-responsive mb-5">
            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Username</th>
                        <th>Student</th>
                        <th>Class</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (!existingUsers || existingUsers.length === 0) { %>
                        <tr><td colspan="4"><%= isTeacherView ? "No students attend your classes yet." : "No approved or rejected student accounts found." %></td></tr>
                    <% } else { %>
                        <% existingUsers.forEach(existingUser => { %>
                            <tr>
                                <td><%= existingUser.username %></td>
                                <td><%= existingUser.student ? existingUser.student.name : "Not linked (legacy account)" %></td>
                                <td><%= existingUser.student ? existingUser.student.className : "-" %></td>
                                <td><%= existingUser.status || "approved" %></td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>

        <hr>

        <h3><%= editGrade ? "Edit Grade" : "Add New Grade" %></h3>

        <form action="<%= editGrade ? '/manage-grades/update' : '/manage-grades/create' %>"
              method="POST" class="mb-5">

            <% if (editGrade) { %>
                <input type="hidden" name="id" value="<%= editGrade._id %>">
            <% } %>

            <div class="form-group mb-3">
                <label>Student</label>
                <select name="student" class="form-control" required>
                    <option value="">Select a student</option>
                    <% students.forEach(student => { %>
                        <option value="<%= student._id %>"
                            <%= editGrade && editGrade.student.toString() === student._id.toString() ? "selected" : "" %>>
                            <%= student.name %> (<%= student.className %>)
                        </option>
                    <% }) %>
                </select>
            </div>

            <div class="form-group mb-3">
                <label>Subject</label>
                <select name="subject" class="form-control" required>
                    <option value="">Select a subject</option>
                    <% subjects.forEach(subject => { %>
                        <option value="<%= subject._id %>"
                            <%= editGrade && editGrade.subject.toString() === subject._id.toString() ? "selected" : "" %>>
                            <%= subject.name %>
                        </option>
                    <% }) %>
                </select>
            </div>

            <div class="form-group mb-3">
                <label>Grade (1–5)</label>
                <input type="number" name="value" class="form-control"
                    min="1" max="5" required
                    value="<%= editGrade ? editGrade.value : '' %>">
            </div>

            <div class="form-group mb-3">
                <label>Grade Type</label>
                <input type="text" name="type" class="form-control"
                    required placeholder="For example: Test"
                    value="<%= editGrade ? editGrade.type : '' %>">
            </div>

            <div class="form-group mb-3">
                <label>Date</label>
                <input type="date" name="date" class="form-control"
                    value="<%= editGrade && editGrade.date ? new Date(editGrade.date).toISOString().slice(0, 10) : '' %>">
            </div>

            <div class="form-group mb-3">
                <label>Notes</label>
                <input type="text" name="note" class="form-control"
                    value="<%= editGrade ? editGrade.note : '' %>">
            </div>

            <button type="submit" class="btn btn-primary">
                <%= editGrade ? "Save Changes" : "Add Grade" %>
            </button>

            <% if (editGrade) { %>
                <a href="/manage-grades" class="btn btn-secondary">Cancel</a>
            <% } %>
        </form>

        <hr>

        <h3 class="mb-3">Recorded Grades</h3>

        <form action="/manage-grades" method="GET" class="border rounded p-3 mb-4">
            <div class="row">
                <div class="col-md-6 col-lg-3 mb-3">
                    <label for="filterClass">Class</label>
                    <select id="filterClass" name="className" class="form-control">
                        <option value="">All classes</option>
                        <% classes.forEach(schoolClass => { %>
                            <option value="<%= schoolClass.name %>" <%= filters.className === schoolClass.name ? "selected" : "" %>>
                                <%= schoolClass.name %>
                            </option>
                        <% }) %>
                    </select>
                </div>
                <div class="col-md-6 col-lg-3 mb-3">
                    <label for="filterStudent">Student</label>
                    <select id="filterStudent" name="studentId" class="form-control">
                        <option value="">All students</option>
                        <% students.forEach(student => { %>
                            <option value="<%= student._id %>"
                                    data-class="<%= student.className %>"
                                    <%= filters.studentId === student._id.toString() ? "selected" : "" %>>
                                <%= student.name %> (<%= student.className %>)
                            </option>
                        <% }) %>
                    </select>
                </div>
                <div class="col-md-6 col-lg-3 mb-3">
                    <label for="dateFrom">Date from</label>
                    <input type="date" id="dateFrom" name="dateFrom" class="form-control" value="<%= filters.dateFrom %>">
                </div>
                <div class="col-md-6 col-lg-3 mb-3">
                    <label for="dateTo">Date to</label>
                    <input type="date" id="dateTo" name="dateTo" class="form-control" value="<%= filters.dateTo %>">
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Apply Filters</button>
            <a href="/manage-grades" class="btn btn-secondary">Clear Filters</a>
        </form>

        <div class="table-responsive">
            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Student</th>
                        <th>Class</th>
                        <th>Subject</th>
                        <th>Grade</th>
                        <th>Type</th>
                        <th>Date</th>
                        <th>Notes</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (grades.length === 0) { %>
                        <tr>
                            <td colspan="8">No grades have been recorded yet.</td>
                        </tr>
                    <% } %>

                    <% grades.forEach(grade => { %>
                        <tr>
                            <td><%= grade.student ? grade.student.name : "Unknown" %></td>
                            <td><%= grade.student ? grade.student.className : "-" %></td>
                            <td><%= grade.subject ? grade.subject.name : "Unknown" %></td>
                            <td><%= grade.value %></td>
                            <td><%= grade.type %></td>
                            <td><%= grade.date ? new Date(grade.date).toLocaleDateString("en-GB") : "-" %></td>
                            <td><%= grade.note || "-" %></td>
                            <td>
                                <a href="/manage-grades?edit=<%= grade._id %>"
                                   class="btn btn-sm btn-warning mb-1">
                                    Edit
                                </a>

                                <form action="/manage-grades/delete" method="POST"
                                      onsubmit="return confirm('Are you sure you want to delete this grade?');">
                                    <input type="hidden" name="id" value="<%= grade._id %>">
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const classSelect = document.getElementById("filterClass");
            const studentSelect = document.getElementById("filterStudent");

            function updateStudentOptions(resetSelection) {
                const selectedClass = classSelect.value;
                const currentStudent = studentSelect.value;

                Array.from(studentSelect.options).forEach(function (option, index) {
                    if (index === 0) return;
                    const belongsToClass = !selectedClass || option.dataset.class === selectedClass;
                    option.hidden = !belongsToClass;
                    option.disabled = !belongsToClass;
                });

                if (resetSelection || (currentStudent && studentSelect.selectedOptions[0].disabled)) {
                    studentSelect.value = "";
                }
            }

            classSelect.addEventListener("change", function () {
                updateStudentOptions(true);
            });

            updateStudentOptions(false);
        });
    </script>

    <%- include("partials/footer") %>
</body>
</html>
