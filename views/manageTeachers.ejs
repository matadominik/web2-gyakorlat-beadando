
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <title>Manage Accounts - E-Crayon</title>
    <link rel="stylesheet" href="/css/bootstrap.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/responsive.css">
</head>
<body class="sub_page">
    <div class="hero_area">
        <%- include("partials/header") %>
    </div>

    <main class="container py-5 account-admin-page">
        <h1 class="mb-4">Account Administration</h1>
        <p class="mb-4">Manage accounts and reset passwords.</p>

        <% if (message) { %>
            <div class="alert alert-info"><%= message %></div>
        <% } %>

        <section class="mb-5">
            <h3 class="mb-3">Pending Student Registrations</h3>
            <p>Only the system administrator can approve or reject new student registrations.</p>
            <div class="table-responsive">
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>Full Name</th>
                            <th>Class</th>
                            <th>Username</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (!pendingUsers || pendingUsers.length === 0) { %>
                            <tr><td colspan="4">There are no pending registrations.</td></tr>
                        <% } else { %>
                            <% pendingUsers.forEach(pendingUser => { %>
                                <tr>
                                    <td><%= pendingUser.student ? pendingUser.student.name : "Student record missing" %></td>
                                    <td><%= pendingUser.student ? pendingUser.student.className : "-" %></td>
                                    <td><%= pendingUser.username %></td>
                                    <td>
                                        <form action="/manage-teachers/approve-user" method="POST" class="d-inline">
                                            <input type="hidden" name="userId" value="<%= pendingUser._id %>">
                                            <button type="submit" class="btn btn-sm btn-success mb-1">Approve</button>
                                        </form>
                                        <form action="/manage-teachers/reject-user" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to reject this registration?');">
                                            <input type="hidden" name="userId" value="<%= pendingUser._id %>">
                                            <button type="submit" class="btn btn-sm btn-danger mb-1">Reject</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </section>

        <hr>

        <section class="mb-5">
            <h3 class="mb-3">Teacher Accounts</h3>
            <div class="table-responsive">
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Username</th>
                            <th>Status</th>
                            <th>Change Password</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (!teachers.length) { %>
                            <tr><td colspan="5">No teacher accounts found.</td></tr>
                        <% } else { %>
                            <% teachers.forEach(teacher => { %>
                                <tr>
                                    <td><%= (teacher.student && teacher.student.name ? teacher.student.name : (teacher.displayName || teacher.username)) %></td>
                                    <td><%= teacher.username %></td>
                                    <td><%= teacher.status === "disabled" ? "Disabled" : "Active" %></td>
                                    <td>
                                        <form method="POST" action="/manage-teachers/change-password" class="d-flex">
                                            <input type="hidden" name="userId" value="<%= teacher._id %>">
                                            <input type="password" name="password" class="form-control form-control-sm mr-2" minlength="8" maxlength="128" placeholder="New password" required>
                                            <button type="submit" class="btn btn-sm btn-primary">Change</button>
                                        </form>
                                    </td>
                                    <td>
                                        <% if (teacher.role === "teacher") { %>
                                            <form method="POST" action="/manage-teachers/delete" onsubmit="return confirm('Delete this teacher account?');">
                                                <input type="hidden" name="userId" value="<%= teacher._id %>">
                                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                            </form>
                                        <% } else { %>
                                            <span class="text-muted">Legacy account</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </section>

        <hr>

        <section class="mt-5">
            <h3 class="mb-3">Registered Student Accounts</h3>
            <div class="table-responsive">
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>Full Name</th>
                            <th>Class</th>
                            <th>Move Class</th>
                            <th>Username</th>
                            <th>Status</th>
                            <th>Change Password</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (!studentAccounts || studentAccounts.length === 0) { %>
                            <tr><td colspan="7">No student accounts found.</td></tr>
                        <% } else { %>
                            <% studentAccounts.forEach(account => { %>
                                <tr>
                                    <td><%= account.student ? account.student.name : (account.displayName || "Student record missing") %></td>
                                    <td><%= account.student ? account.student.className : "-" %></td>
                                    <td>
                                        <% if (account.student && classes && classes.length) { %>
                                            <form method="POST" action="/manage-teachers/move-student" class="d-flex">
                                                <input type="hidden" name="userId" value="<%= account._id %>">
                                                <select name="className" class="form-control form-control-sm mr-2" required>
                                                    <% classes.forEach(schoolClass => { %>
                                                        <option value="<%= schoolClass.name %>" <%= account.student.className === schoolClass.name ? "selected" : "" %>><%= schoolClass.name %></option>
                                                    <% }) %>
                                                </select>
                                                <button type="submit" class="btn btn-sm btn-primary">Move</button>
                                            </form>
                                        <% } else { %>
                                            -
                                        <% } %>
                                    </td>
                                    <td><%= account.username %></td>
                                    <td><%= account.status || "approved" %></td>
                                    <td>
                                        <form method="POST" action="/manage-teachers/change-password" class="d-flex">
                                            <input type="hidden" name="userId" value="<%= account._id %>">
                                            <input type="password" name="password" class="form-control form-control-sm mr-2" minlength="8" maxlength="128" placeholder="New password" required>
                                            <button type="submit" class="btn btn-sm btn-primary">Change</button>
                                        </form>
                                    </td>
                                    <td>
                                        <form method="POST" action="/manage-teachers/delete-student" onsubmit="return confirm('Permanently delete this student profile, login account and all associated grades? This cannot be undone.');">
                                            <input type="hidden" name="userId" value="<%= account._id %>">
                                            <button type="submit" class="btn btn-sm btn-danger">Delete Profile</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </section>

        <hr>

        <section class="mt-5 mb-5">
            <h3 class="mb-3">Subjects and Teacher Assignment</h3>
            <form method="POST" action="/manage-teachers/subjects/create" class="row align-items-end mb-4">
                <div class="col-md-5 mb-2">
                    <label for="subjectName">Subject name</label>
                    <input id="subjectName" name="name" class="form-control" maxlength="80" required>
                </div>
                <div class="col-md-5 mb-2">
                    <label for="subjectTeacher">Assigned teacher</label>
                    <select id="subjectTeacher" name="teacherId" class="form-control" required>
                        <option value="">Select teacher</option>
                        <% teachers.filter(item => item.status !== "disabled").forEach(teacher => { %>
                            <option value="<%= teacher._id %>"><%= (teacher.student && teacher.student.name ? teacher.student.name : (teacher.displayName || teacher.username)) %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="col-md-2 mb-2">
                    <button type="submit" class="btn btn-primary btn-block">Add Subject</button>
                </div>
            </form>
            <div class="table-responsive">
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr><th>Subject</th><th>Teacher</th></tr>
                    </thead>
                    <tbody>
                        <% if (!subjects || !subjects.length) { %>
                            <tr><td colspan="2">No subjects have been added yet.</td></tr>
                        <% } %>
                        <% (subjects || []).forEach(subject => { %>
                            <tr>
                                <td><%= subject.name %></td>
                                <td><%= subject.teacher ? (subject.teacher.student && subject.teacher.student.name ? subject.teacher.student.name : (subject.teacher.displayName || subject.teacher.username)) : (subject.teacherName || "Not assigned") %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </section>

        <hr>

        <section class="mt-5 mb-5">
            <h3 class="mb-3">Weekly Timetable</h3>
            <p>Lessons repeat weekly between September 1 and May 31. The teacher is taken automatically from the subject assignment.</p>
            <form method="POST" action="/manage-teachers/timetable/create" class="row align-items-end">
                <div class="col-md-3 mb-2">
                    <label>Class</label>
                    <select name="className" class="form-control" required>
                        <option value="">Select class</option>
                        <% classes.forEach(item => { %>
                            <option value="<%= item.name %>"><%= item.name %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="col-md-3 mb-2">
                    <label>Subject</label>
                    <select name="subjectId" class="form-control" required>
                        <option value="">Select subject</option>
                        <% subjects.forEach(item => { %>
                            <option value="<%= item._id %>"><%= item.name %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="col-md-3 mb-2">
                    <label>Day</label>
                    <select name="dayOfWeek" class="form-control" required>
                        <option value="1">Monday</option>
                        <option value="2">Tuesday</option>
                        <option value="3">Wednesday</option>
                        <option value="4">Thursday</option>
                        <option value="5">Friday</option>
                    </select>
                </div>
                <div class="col-md-2 mb-2">
                    <label>From</label>
                    <input type="time" name="startTime" class="form-control" required>
                </div>
                <div class="col-md-2 mb-2">
                    <label>To</label>
                    <input type="time" name="endTime" class="form-control" required>
                </div>
                <div class="col-md-3 mb-2">
                    <label>Active from</label>
                    <input type="date" name="activeFrom" class="form-control" value="<%= defaultActiveFrom %>" required>
                </div>
                <div class="col-md-3 mb-2">
                    <label>Active until</label>
                    <input type="date" name="activeTo" class="form-control" value="<%= defaultActiveTo %>" required>
                </div>
                <div class="col-md-2 mb-2">
                    <button type="submit" class="btn btn-primary btn-block">Add Lesson</button>
                </div>
            </form>
            <div class="table-responsive mt-4">
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>Class</th>
                            <th>Day</th>
                            <th>Time</th>
                            <th>Subject</th>
                            <th>Teacher</th>
                            <th>Period</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (!timetableEntries || !timetableEntries.length) { %>
                            <tr><td colspan="7">No timetable lessons added yet.</td></tr>
                        <% } %>
                        <% const dayNames = ["", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday"]; %>
                        <% (timetableEntries || []).forEach(entry => { %>
                            <tr>
                                <td><%= entry.className %></td>
                                <td><%= dayNames[entry.dayOfWeek] || "-" %></td>
                                <td><%= entry.startTime %>–<%= entry.endTime %></td>
                                <td><%= entry.subject ? entry.subject.name : "Deleted subject" %></td>
                                <td><%= entry.teacher ? (entry.teacher.student && entry.teacher.student.name ? entry.teacher.student.name : (entry.teacher.displayName || entry.teacher.username)) : "Deleted teacher" %></td>
                                <td><%= new Date(entry.activeFrom).toLocaleDateString("en-GB") %> – <%= new Date(entry.activeTo).toLocaleDateString("en-GB") %></td>
                                <td>
                                    <form method="POST" action="/manage-teachers/timetable/delete" onsubmit="return confirm('Delete this timetable lesson?');">
                                        <input type="hidden" name="entryId" value="<%= entry._id %>">
                                        <button class="btn btn-sm btn-danger" type="submit">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </section>

        <hr>
    </main>

    <%- include("partials/footer") %>
</body>
</html>
