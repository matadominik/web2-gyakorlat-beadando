<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Manage Accounts - E-Crayon</title>
    <link rel="stylesheet" href="/css/bootstrap.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/responsive.css">
</head>
<body class="sub_page">
    <div class="hero_area">
        <%- include("partials/header") %>
    </div>

    <main class="container py-5">
        <h1 class="mb-4">Account Administration</h1>
        <p class="mb-4">Promote registered student accounts to teachers, manage accounts and reset passwords.</p>

        <% if (message) { %>
            <div class="alert alert-info"><%= message %></div>
        <% } %>

        <section class="mb-5">
            <h3 class="mb-3">Teacher Accounts</h3>
            <div class="table-responsive">
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr><th>Name</th><th>Username</th><th>Status</th><th>Change Password</th><th>Action</th></tr>
                    </thead>
                    <tbody>
                        <% if (!teachers.length) { %>
                            <tr><td colspan="5">No teacher accounts found.</td></tr>
                        <% } else { %>
                            <% teachers.forEach(teacher => { %>
                                <tr>
                                    <td><%= teacher.displayName || teacher.username %></td>
                                    <td><%= teacher.username %></td>
                                    <td><%= teacher.status === "disabled" ? "Disabled" : "Active" %></td>
                                    <td>
                                        <form method="POST" action="/manage-teachers/change-password" class="d-flex">
                                            <input type="hidden" name="userId" value="<%= teacher._id %>">
                                            <input type="password" name="password" class="form-control form-control-sm mr-2" minlength="8" maxlength="128" placeholder="New password" required>
                                            <button type="submit" class="btn btn-sm btn-primary">Change</button>
                                        </form>
                                    </td>
                                    <td>
                                        <% if (teacher.role === "teacher") { %>
                                            <form method="POST" action="/manage-teachers/delete" onsubmit="return confirm('Delete this teacher account?');">
                                                <input type="hidden" name="userId" value="<%= teacher._id %>">
                                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                            </form>
                                        <% } else { %>
                                            <span class="text-muted">Legacy account</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </section>

        <hr>

        <section class="mt-5">
            <h3 class="mb-3">Registered Student Accounts</h3>
            <p>Only approved accounts can be promoted to teacher. A promoted account keeps its existing username and password.</p>
            <div class="table-responsive">
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr><th>Full Name</th><th>Class</th><th>Username</th><th>Status</th><th>Change Password</th><th>Actions</th></tr>
                    </thead>
                    <tbody>
                        <% if (!studentAccounts || studentAccounts.length === 0) { %>
                            <tr><td colspan="6">No student accounts found.</td></tr>
                        <% } else { %>
                            <% studentAccounts.forEach(account => { %>
                                <tr>
                                    <td><%= account.student ? account.student.name : (account.displayName || "Student record missing") %></td>
                                    <td><%= account.student ? account.student.className : "-" %></td>
                                    <td><%= account.username %></td>
                                    <td><%= account.status || "approved" %></td>
                                    <td>
                                        <form method="POST" action="/manage-teachers/change-password" class="d-flex">
                                            <input type="hidden" name="userId" value="<%= account._id %>">
                                            <input type="password" name="password" class="form-control form-control-sm mr-2" minlength="8" maxlength="128" placeholder="New password" required>
                                            <button type="submit" class="btn btn-sm btn-primary">Change</button>
                                        </form>
                                    </td>
                                    <td>
                                        <% if (account.status === "approved") { %>
                                            <form method="POST" action="/manage-teachers/promote" class="mb-2" onsubmit="return confirm('Promote this account to teacher? The user will get teacher access instead of student access.');">
                                                <input type="hidden" name="userId" value="<%= account._id %>">
                                                <button type="submit" class="btn btn-sm btn-success">Make Teacher</button>
                                            </form>
                                        <% } %>
                                        <form method="POST" action="/manage-teachers/delete-student" onsubmit="return confirm('Permanently delete this student profile, login account and all associated grades? This cannot be undone.');">
                                            <input type="hidden" name="userId" value="<%= account._id %>">
                                            <button type="submit" class="btn btn-sm btn-danger">Delete Profile</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </section>
    </main>

    <%- include("partials/footer") %>
</body>
</html>
