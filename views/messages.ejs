<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>Messages - E-Crayon</title>
  <link rel="stylesheet" href="/css/bootstrap.css"><link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="/css/responsive.css">
  <style>
    .messaging-shell{display:grid;grid-template-columns:300px 1fr;gap:20px;min-height:520px}
    .message-panel{border:1px solid #dee2e6;border-radius:10px;background:#fff;padding:18px}
    .contact-link{display:block;padding:12px;border-bottom:1px solid #eee;color:#212529;text-decoration:none}
    .contact-link.active{background:#eef4ff;border-radius:7px}
    .thread{height:390px;overflow-y:auto;background:#f7f8fa;border-radius:8px;padding:15px;margin-bottom:15px}
    .bubble{max-width:78%;padding:10px 14px;border-radius:12px;margin:8px 0;background:#fff;border:1px solid #e5e7eb}
    .bubble.mine{margin-left:auto;background:#e7f1ff;border-color:#cfe2ff}
    @media(max-width:767px){.messaging-shell{grid-template-columns:1fr}.thread{height:330px}}
  </style>
</head>
<body class="sub_page">
  <div class="hero_area"><%- include("partials/header") %></div>
  <section class="event_section layout_padding"><div class="container">
    <div class="heading_container"><h3>Messages</h3><p>Private messages between students and their teachers.</p></div>
    <% if (message) { %><div class="alert alert-info"><%= message %></div><% } %>
    <div class="messaging-shell">
      <aside class="message-panel">
        <h5>People you can contact</h5>
        <% if (!contacts.length) { %><p class="text-muted">No available contacts. Your class timetable may not have teachers assigned yet.</p><% } %>
        <% contacts.forEach(contact => { %>
          <a class="contact-link <%= selectedContact && String(selectedContact._id) === String(contact._id) ? 'active' : '' %>" href="/messages?to=<%= contact._id %>"><strong><%= contact.label %></strong></a>
        <% }) %>
        <% if (conversations.length) { %><hr><h5>Recent conversations</h5>
          <% conversations.forEach(conversation => { %>
            <a class="contact-link" href="/messages?to=<%= conversation.contact._id %>"><%= conversation.contact.label %><br><small class="text-muted"><%= conversation.messages[conversation.messages.length - 1].body.slice(0, 55) %></small></a>
          <% }) %>
        <% } %>
      </aside>
      <main class="message-panel">
        <% if (!selectedContact) { %>
          <h5>Select a recipient</h5><p class="text-muted">Choose a teacher or student from the list to open a conversation.</p>
        <% } else { %>
          <h5>To: <%= selectedContact.label %></h5>
          <div class="thread" id="messageThread">
            <% if (!thread.length) { %><p class="text-muted">This is the beginning of your conversation.</p><% } %>
            <% thread.forEach(item => { const mine = String(item.sender._id) === String(currentAccount._id); %>
              <div class="bubble <%= mine ? 'mine' : '' %>">
                <strong><%= mine ? 'You' : (item.senderName || item.sender.displayName || item.sender.username) %></strong>
                <% if (item.senderRole === 'user' && item.senderClass) { %><small class="text-muted"> · <%= item.senderClass %></small><% } %>
                <div style="white-space:pre-wrap;overflow-wrap:anywhere"><%= item.body %></div>
                <small class="text-muted"><%= new Date(item.createdAt).toLocaleString('hu-HU') %></small>
              </div>
            <% }) %>
          </div>
          <form method="POST" action="/messages/send">
            <input type="hidden" name="recipient" value="<%= selectedContact._id %>">
            <div class="form-group"><label for="body">Your message</label><textarea class="form-control" id="body" name="body" rows="3" maxlength="4000" required placeholder="Write your message..."></textarea></div>
            <button type="submit" class="btn btn-primary">Send message</button>
          </form>
        <% } %>
      </main>
    </div>
  </div></section>
  <%- include("partials/footer") %>
  <script>const thread = document.getElementById('messageThread'); if (thread) thread.scrollTop = thread.scrollHeight;</script>
</body>
</html>
