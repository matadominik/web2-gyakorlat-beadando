
<section class="info_section layout_padding">
    <div class="container">
        <div class="row">
            <div class="col-md-3">
                <div class="info_menu">
                    <h5>QUICK LINKS</h5>

                    <ul class="navbar-nav">
                        <li class="nav-item <%= currentPath === '/' ? 'active' : '' %>">
                            <a class="nav-link" href="/">Home</a>
                        </li>

                        <li class="nav-item <%= currentPath === '/gradebook' ? 'active' : '' %>">
                            <a class="nav-link" href="/gradebook">Gradebook</a>
                        </li>

                        <li class="nav-item <%= currentPath === '/stats' ? 'active' : '' %>">
                            <a class="nav-link" href="/stats">Statistics</a>
                        </li>

                        <li class="nav-item <%= currentPath === '/contact' ? 'active' : '' %>">
                            <a class="nav-link" href="/contact">Contact</a>
                        </li>

                        <% if (user) { %>
                            <li class="nav-item <%= currentPath === '/feedback' ? 'active' : '' %>">
                                <a class="nav-link" href="/feedback">Messages</a>
                            </li>
                        <% } %>

                        <% if (user && user.role === "admin") { %>
                            <li class="nav-item <%= currentPath === '/manage-grades' ? 'active' : '' %>">
                                <a class="nav-link" href="/manage-grades">Manage Grades</a>
                            </li>
                        <% } %>
                    </ul>
                </div>
            </div>

            <div class="col-md-3">
                <div class="info_course">
                    <h5>Welcome to E-Crayon</h5>
                    <p>
                        E-Crayon is an electronic gradebook application
                        for managing students, subjects and grades.
                        Browse academic records and explore grade statistics.
                    </p>
                </div>
            </div>

            <div class="col-md-5 offset-md-1">
                <div class="info_news">
                    <h5>PROJECT AUTHORS</h5>

                    <div class="info_contact">
                        <a href="https://github.com/matadominik" target="_blank" rel="noopener noreferrer">
                            Mata László Dominik (matadominik - B223VA)
                        </a>

                        <a href="https://github.com/Bencuska0812" target="_blank" rel="noopener noreferrer">
                            Fazekas Bence (Bencuska0812 - ZK6FMO)
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<footer class="container-fluid footer_section">
    <p>
        &copy; 2026 E-Crayon. All rights reserved.
    </p>
</footer>

<script type="text/javascript" src="/js/jquery-3.4.1.min.js"></script>
<script type="text/javascript" src="/js/bootstrap.js"></script>
