
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <title>Statistics - E-Crayon</title>
    <link rel="stylesheet" href="/css/bootstrap.css">
    <link href="https://fonts.googleapis.com/css?family=Open+Sans:400,700|Poppins:400,600,700&display=swap" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
    <link href="/css/responsive.css" rel="stylesheet">
    <style>
        .stats-card { background:#fff; border:1px solid #e5e7eb; border-radius:10px; padding:22px; margin-bottom:18px; }
        .stats-number { font-size:2rem; font-weight:700; color:#243b53; }
        .grade-row { display:grid; grid-template-columns:75px 1fr 45px; gap:14px; align-items:center; margin:18px 0; }
        .grade-track { height:18px; background:#edf1f5; border-radius:10px; overflow:hidden; }
        .grade-fill { height:100%; background:#3978c5; border-radius:10px; }
        .grade-label { font-weight:700; }
    </style>
</head>
<body class="sub_page">
    <div class="hero_area">
        <%- include("partials/header") %>
    </div>
    <section class="event_section layout_padding">
        <div class="container">
            <div class="heading_container">
                <h3>Statistics</h3>
                <p>An overview and distribution of your grades.</p>
            </div>
            <% if (accountNotLinked) { %>
                <div class="alert alert-warning mt-4">
                    Your account is not linked to a student profile. Please contact the administrator.
                </div>
            <% } else { %>
                <div class="row mt-4">
                    <div class="col-md-6">
                        <div class="stats-card">
                            <div class="text-muted">Total Grades</div>
                            <div class="stats-number"><%= totalGrades %></div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="stats-card">
                            <div class="text-muted">Average Grade</div>
                            <div class="stats-number"><%= totalGrades ? (gradeCounts.reduce((sum, count, index) => sum + count * (index + 1), 0) / totalGrades).toFixed(2) : "—" %></div>
                        </div>
                    </div>
                </div>
                <div class="stats-card">
                    <h4 class="mb-4">Grade Distribution</h4>
                    <canvas id="gradeChart" aria-label="Grade distribution chart" role="img"></canvas>
                </div>
            <% } %>
        </div>
    </section>
    <%- include("partials/footer") %>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const gradeChartCanvas = document.getElementById("gradeChart");
        if (gradeChartCanvas) {
            new Chart(gradeChartCanvas, {
                type: "bar",
                data: {
                    labels: ["Grade 1", "Grade 2", "Grade 3", "Grade 4", "Grade 5"],
                    datasets: [{
                        label: "Number of Grades",
                        data: <%- JSON.stringify(gradeCounts) %>,
                        backgroundColor: ["#d9534f", "#f0ad4e", "#5bc0de", "#5cb85c", "#3978c5"],
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    scales: { y: { beginAtZero: true, ticks: { precision: 0 } } },
                    plugins: { legend: { display: true } }
                }
            });
        }
    </script>
</body>
</html>
