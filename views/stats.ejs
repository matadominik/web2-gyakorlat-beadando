
<!DOCTYPE html>
<html lang="hu">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Statisztikák - E-Crayon</title>

    <link rel="stylesheet" href="/css/bootstrap.css" />
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/responsive.css" />

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body class="sub_page">
    <div class="hero_area">
        <%- include("partials/header") %>
    </div>

    <div class="container py-5">
        <h1 class="mb-3">Jegystatisztikák</h1>
        <p>Az adatbázisban rögzített érdemjegyek összesítése.</p>

        <div class="row mb-4">
            <div class="col-md-4">
                <div class="card p-3 text-center">
                    <h5>Összes rögzített jegy</h5>
                    <h2><%= totalGrades %></h2>
                </div>
            </div>
        </div>

        <% if (totalGrades === 0) { %>
            <div class="alert alert-info">
                Jelenleg még nincs elegendő adat a statisztika megjelenítéséhez.
            </div>
        <% } %>

        <div class="card p-4">
            <h4 class="mb-3">Jegyek eloszlása</h4>
            <div style="position: relative; height: 350px;">
                <canvas id="gradeChart"></canvas>
            </div>
        </div>
    </div>

    <%- include("partials/footer") %>

    <script>
        const gradeCounts = JSON.parse('<%- JSON.stringify(gradeCounts || [0, 0, 0, 0, 0]) %>');

        const ctx = document.getElementById("gradeChart");

        new Chart(ctx, {
            type: "bar",
            data: {
                labels: ["Elégtelen (1)", "Elégséges (2)", "Közepes (3)", "Jó (4)", "Jeles (5)"],
                datasets: [{
                    label: "Jegyek száma",
                    data: gradeCounts,
                    backgroundColor: [
                        "#dc3545",
                        "#fd7e14",
                        "#ffc107",
                        "#0d6efd",
                        "#198754"
                    ],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            precision: 0
                        },
                        title: {
                            display: true,
                            text: "Jegyek darabszáma"
                        }
                    }
                },
                plugins: {
                    legend: {
                        display: false
                    },
                    title: {
                        display: true,
                        text: "Érdemjegyek eloszlása"
                    }
                }
            }
        });
    </script>
</body>
</html>
