<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Grade Statistics - E-Crayon</title>
    <link rel="stylesheet" href="/css/bootstrap.css">
    <link href="https://fonts.googleapis.com/css?family=Open+Sans:400,700|Poppins:400,600,700&display=swap" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
    <link href="/css/responsive.css" rel="stylesheet">
    <style>
        .stats-card { background:#fff; border:1px solid #e5e7eb; border-radius:10px; padding:22px; margin-bottom:18px; }
        .stats-number { font-size:2rem; font-weight:700; color:#243b53; }
        .grade-row { display:grid; grid-template-columns:75px 1fr 45px; gap:14px; align-items:center; margin:18px 0; }
        .grade-track { height:18px; background:#edf1f5; border-radius:10px; overflow:hidden; }
        .grade-fill { height:100%; background:#3978c5; border-radius:10px; }
        .grade-label { font-weight:700; }
    </style>
</head>
<body class="sub_page">
    <div class="hero_area">
        <%- include("partials/header") %>
    </div>
    <section class="event_section layout_padding">
        <div class="container">
            <div class="heading_container">
                <h3>Grade Statistics</h3>
                <p>Overview of your recorded grades.</p>
            </div>
            <% if (accountNotLinked) { %>
                <div class="alert alert-warning mt-4">
                    Your account is not linked to a student profile. Please contact the administrator.
                </div>
            <% } else { %>
                <div class="row mt-4">
                    <div class="col-md-6">
                        <div class="stats-card">
                            <div class="text-muted">Total grades</div>
                            <div class="stats-number"><%= totalGrades %></div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="stats-card">
                            <div class="text-muted">Average grade</div>
                            <div class="stats-number"><%= totalGrades ? (gradeCounts.reduce((sum, count, index) => sum + count * (index + 1), 0) / totalGrades).toFixed(2) : "—" %></div>
                        </div>
                    </div>
                </div>
                <div class="stats-card">
                    <h4 class="mb-4">Distribution by grade</h4>
                    <% const maxCount = Math.max(1, ...gradeCounts); %>
                    <% gradeCounts.forEach((count, index) => { %>
                        <div class="grade-row">
                            <div class="grade-label">Grade <%= index + 1 %></div>
                            <div class="grade-track">
                                <div class="grade-fill" style="width:<%= (count / maxCount) * 100 %>%"></div>
                            </div>
                            <div class="text-right"><%= count %></div>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>
    </section>
    <%- include("partials/footer") %>
</body>
</html>
