<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>My Timetable - E-Crayon</title>
<link rel="stylesheet" href="/css/bootstrap.css"><link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="/css/responsive.css">
<style>
.timetable-wrap{overflow-x:auto;background:#fff;border:1px solid #e6e9f2;border-radius:12px;padding:12px}
.timetable-grid{display:grid;grid-template-columns:82px repeat(5,minmax(145px,1fr));min-width:850px}
.tt-head,.tt-time,.tt-cell{border-right:1px solid #e9edf5;border-bottom:1px solid #e9edf5;padding:10px;min-height:76px}
.tt-head{text-align:center;font-weight:700;background:#f8f9fc;min-height:58px}
.tt-time{font-weight:600;color:#555;text-align:center}
.tt-lesson{background:#f0f2fb;border-radius:8px;padding:10px;margin-bottom:7px;border-left:4px solid #5366a5;font-size:13px}
.tt-lesson strong,.tt-lesson span{display:block}.tt-lesson strong{color:#25345d}.tt-lesson span{color:#59647e;margin-top:4px}
.week-nav{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:18px}
</style>
</head>
<body class="sub_page">
<div class="hero_area"><%- include("partials/header") %></div>
<main class="container py-5">
<h3 class="mb-3">My Timetable</h3>
<% if (isTeacher) { %>
<p class="text-muted">Your weekly teaching schedule, including the classes you teach.</p>
<% } else { %>
<p>Class: <strong><%= className %></strong></p>
<% } %>
<div class="week-nav">
<a class="btn btn-outline-primary" href="/timetable?week=<%= previousWeek.toISOString().slice(0,10) %>">&larr; Previous week</a>
<div class="text-center"><strong><%= weekStart.toLocaleDateString("en-GB", {day:"2-digit",month:"short",year:"numeric",timeZone:"UTC"}) %> – <%= weekEnd.toLocaleDateString("en-GB", {day:"2-digit",month:"short",year:"numeric",timeZone:"UTC"}) %></strong><div><a href="/timetable">Current week</a></div></div>
<a class="btn btn-outline-primary" href="/timetable?week=<%= nextWeek.toISOString().slice(0,10) %>">Next week &rarr;</a>
</div>
<p class="text-muted small">Timetable repeats weekly during the school year: <%= periodStart.toLocaleDateString("en-GB",{timeZone:"UTC"}) %> – <%= periodEnd.toLocaleDateString("en-GB",{timeZone:"UTC"}) %>.</p>
<% const days=["Monday","Tuesday","Wednesday","Thursday","Friday"]; const slots=[...new Set(timetableEntries.map(e=>e.startTime+"|"+e.endTime))].sort(); %>
<div class="timetable-wrap"><div class="timetable-grid">
<div class="tt-head">Time</div>
<% days.forEach((day,index)=>{ const date=new Date(weekStart); date.setUTCDate(date.getUTCDate()+index); %>
<div class="tt-head"><%= day %><br><small><%= date.toLocaleDateString("en-GB",{day:"2-digit",month:"2-digit",timeZone:"UTC"}) %></small></div>
<% }) %>
<% if(!slots.length){ %><div class="tt-time">—</div><div class="tt-cell" style="grid-column:span 5;">No timetable entries for this week.</div><% } %>
<% slots.forEach(slot=>{ const parts=slot.split("|"); %>
<div class="tt-time"><%= parts[0] %><br><small><%= parts[1] %></small></div>
<% [1,2,3,4,5].forEach(day=>{ const lesson=timetableEntries.find(e=>e.dayOfWeek===day&&e.startTime===parts[0]&&e.endTime===parts[1]); %>
<div class="tt-cell"><% if(lesson){ %><div class="tt-lesson">
<strong><%= lesson.subject?lesson.subject.name:"Subject" %></strong>
<span><%= lesson.teacher?(lesson.teacher.displayName||lesson.teacher.username):"Teacher" %></span>
<% if(isTeacher){ %><span><strong>Class: <%= lesson.className %></strong></span><% } %>
<span><%= lesson.startTime %> – <%= lesson.endTime %></span>
</div><% } %></div>
<% }) %><% }) %>
</div></div>
</main>
<%- include("partials/footer") %>
</body></html>
